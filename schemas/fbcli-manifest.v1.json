          "required": false,
          "default": false,
          "description": "Skip /me and /me/permissions calls."
        }
      ],
      "arguments": [],
      "output_contract": {
        "top_level_keys": [
          "meta",
          "data"
        ],
        "key_notes": {
          "data": "Includes source (env/store), auth state, and permissions when API check is enabled."
        },
        "conditional_notes": [
          "When no token is available, data.authenticated is false and source is none."
