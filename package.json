{
  "name": "fbcli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "fbcli": "dist/index.js"
  },
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --target bun",
    "typecheck": "tsc --noEmit",
    "dev": "bun src/index.ts",
    "manifest": "bun src/index.ts help --json",
    "test": "bun test",
    "ci:check": "bun run typecheck && bun run build && bun test"
  },
  "dependencies": {
    "commander": "^14.0.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.9.2"
  }
}
